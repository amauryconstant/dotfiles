#!/usr/bin/env sh
# uwsm session environment
# Sourced by uwsm at every login, before Hyprland starts. Every variable it
# exports reaches the compositor AND the systemd user manager — which is the
# point: quickshell.service, and every app it launches through
# `systemd-run --scope` (Config.detach), inherits the manager's environment,
# not Hyprland's. hl.env() in hypr/conf/environment.lua only reached Hyprland's
# own children, so apps launched from the Quickshell launcher ran without any
# of this (measured 2026-10-06: no MOZ_ENABLE_WAYLAND, GDK_BACKEND, ELECTRON_*).
#
# 🚨 A failure here aborts the session start. Check both chassis renders:
#   chezmoi execute-template [--override-data '{"chassisType":"desktop"}'] \
#     < private_dot_config/uwsm/env.tmpl | sh -n
#
# Changes require logout/login. XDG_SESSION_TYPE is not set here: uwsm sets it.

# mise shims: makes mise-managed tools (node, ruby, etc.) visible to apps
# launched from Hyprland that don't go through a login shell
eval "$(mise activate bash --shims)"
{{- if eq .chassisType "desktop" }}

# ----------------------------------------------------------------------------
# NVIDIA (nvidia-open) — DESKTOP ONLY
# ----------------------------------------------------------------------------
# Desktop has a discrete GPU only; laptop has hybrid GPU and uses auto-detect.

# Hardware video acceleration driver (VA-API)
export LIBVA_DRIVER_NAME=nvidia
# VA-API backend (requires libva-nvidia-driver)
export NVD_BACKEND=direct
# Graphics Buffer Manager backend for NVIDIA DRM
export GBM_BACKEND=nvidia-drm
# OpenGL vendor library
export __GLX_VENDOR_LIBRARY_NAME=nvidia
# Prevent screen tearing with VSync
export __GL_SYNC_TO_VBLANK=1
{{- end }}

# Hardware cursor support (test mode for modern NVIDIA drivers 580+)
# Legacy value: 1 (disabled) - Previous workaround for NVIDIA cursor bugs
# If cursor issues occur (invisible cursor, rendering artifacts), revert to 1
export WLR_NO_HARDWARE_CURSORS=0

# ----------------------------------------------------------------------------
# Qt/GTK
# ----------------------------------------------------------------------------
# Qt theme engine (qt5ct for manual theming)
export QT_QPA_PLATFORMTHEME=qt5ct
# Force Qt applications to use Wayland (instead of XWayland fallback)
export QT_QPA_PLATFORM=wayland
# Disable Qt's client-side decorations (use Hyprland's window decorations)
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
# Force GTK applications to use Wayland backend (fallback: "wayland,x11")
export GDK_BACKEND=wayland
# Disable GTK4 Settings portal — makes ~/.config/gtk-4.0/settings.ini the
# primary source for icon theme, font, cursor, gtk-theme. libadwaita apps read
# color-scheme via their own portal connection (unaffected).
export GDK_DEBUG=no-portals

# Cursor size in pixels (24 standard, 32 large, 48 HiDPI)
export XCURSOR_SIZE=24

# ----------------------------------------------------------------------------
# Browser & Electron
# ----------------------------------------------------------------------------
# Firefox native Wayland
export MOZ_ENABLE_WAYLAND=1
# Wayland for Electron apps (VS Code, Slack, Discord, etc.)
export ELECTRON_OZONE_PLATFORM_HINT=auto
# Explicit sync (syncobj) for Electron/CEF (Electron 35+/Chromium 134+) —
# resolves flickering on NVIDIA
export ELECTRON_FLAGS=--enable-features=WaylandLinuxDrmSyncobj
