# Zsh function: ccp
# Launch Claude Code with merged settings profiles, optionally under a separate account
# (-a NAME -> CLAUDE_CONFIG_DIR=~/.config/claude-NAME: own login/history/plugins; profiles and
# base settings still come from ~/.config/claude, with the account's live settings.json and its
# ccp-only overrides in ~/.config/claude/accounts/NAME.json layered between them; --new required
# to create an account that has neither)
# -C/--caveman launches through `caveman claude` (args pass through to claude untouched); without
# it the session talks to Anthropic directly even though settings.json carries caveman's route. Uppercase
# on purpose: before `--`, a lowercase -c would silently swallow a mistyped claude --continue.

ccp() {
  local CLAUDE_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claude"
  local CLAUDE_PROFILES_DIR="${CLAUDE_CONFIG_DIR}/profiles"
  local CLAUDE_ACCOUNTS_DIR="${CLAUDE_CONFIG_DIR}/accounts"
  local base_settings="${CLAUDE_CONFIG_DIR}/settings.json"
  local profile_names=()
  local claude_args=()
  local parsing_profiles=true
  local account="" allow_new=false use_caveman=false

  while (( $# )); do
    if ! $parsing_profiles; then
      claude_args+=("$1")
    elif [[ "$1" == "--" ]]; then
      parsing_profiles=false
    elif [[ "$1" == -C || "$1" == --caveman ]]; then
      use_caveman=true
    elif [[ "$1" == -n || "$1" == --new ]]; then
      allow_new=true
    elif [[ "$1" == -a || "$1" == --account ]]; then
      account="${2:-}"
      [[ -z "$account" ]] && echo "ccp: $1 needs an account name" >&2 && return 1
      [[ "$account" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "ccp: invalid account name: $account" >&2; return 1; }
      shift
    else
      profile_names+=("$1")
    fi
    shift
  done

  if [[ ${#profile_names[@]} -eq 0 && -z "$account" ]]; then
    echo "Usage: ccp [-C] [-a <account> [--new]] <profile> [profile2...] [-- <claude args>]"
    echo "       ccp -a <account>    (account only, base settings)"
    echo "       -C, --caveman       launch via \`caveman claude\`"
    echo ""
    echo "Available profiles:"
    ls "$CLAUDE_PROFILES_DIR"/*.json 2>/dev/null | xargs -n1 basename | sed 's/\.json$//'
    return 0
  fi

  local launcher=(claude)
  if $use_caveman; then
    (( $+commands[caveman] )) || { echo "ccp: caveman not found on PATH" >&2; return 1; }
    launcher=(caveman claude)
  fi

  for p in "${profile_names[@]}"; do
    [[ ! -f "${CLAUDE_PROFILES_DIR}/${p}.json" ]] && echo "Profile not found: $p" >&2 && return 1
  done

  local account_dir="$CLAUDE_CONFIG_DIR"
  if [[ -n "$account" ]]; then
    account_dir="${XDG_CONFIG_HOME:-$HOME/.config}/claude-${account}"
    if [[ ! -d "$account_dir" && ! -f "$CLAUDE_ACCOUNTS_DIR/$account.json" ]] && ! $allow_new; then
      echo "ccp: unknown account '$account' ($account_dir missing); add --new to create it" >&2
      return 1
    fi
  fi

  local merged_name="${(j:+:)profile_names}"
  merged_name="${merged_name:-base}${account:+@$account}"
  local tmpfile="${CLAUDE_CONFIG_DIR}/profiles/.merged-${merged_name}.json"

  local profile_files=("${profile_names[@]/#/${CLAUDE_PROFILES_DIR}/}")
  profile_files=("${profile_files[@]/%/.json}")
  # caveman's native integration writes its proxy route into the base settings.json, so every
  # merge would inherit it and -C would change nothing. Without -C, point a caveman route back at
  # Anthropic; a profile's own backend (glm, minimax) is left alone. It must be overridden, not
  # deleted: claude still reads the base file itself, and only a --settings value outranks it.
  # Layers: base settings.json, the account's live settings.json, accounts/NAME.json, then each
  # profile in order. claude reads the live account file itself as user settings, which --settings
  # outranks, so without that layer base would beat what /config writes there. accounts/NAME.json
  # holds the account's declared overrides; claude never reads it, so a "$reset" in it cannot leak
  # the way one in the live file would. Objects deep-merge and scalars from a later layer win;
  # arrays concatenate and dedupe (Claude's own scope semantics), unless a layer's array starts
  # with "$reset", which drops what it inherits. "$reset" is ccp's, stripped here.
  local merged
  local account_settings=()
  if [[ -n "$account" ]]; then
    [[ -f "$account_dir/settings.json" ]] && account_settings+=("$account_dir/settings.json")
    [[ -f "$CLAUDE_ACCOUNTS_DIR/$account.json" ]] && account_settings+=("$CLAUDE_ACCOUNTS_DIR/$account.json")
  fi
  merged=$(cat "$base_settings" "${account_settings[@]}" "${profile_files[@]}" | jaq -s --argjson caveman "$use_caveman" '
    def uniq: reduce .[] as $x ([]; if (map(select(. == $x)) | length) > 0 then . else . + [$x] end);
    def dm($a; $b):
      if ($a|type) == "object" and ($b|type) == "object" then
        reduce ($b|keys[]) as $k ($a; .[$k] = dm($a[$k]; $b[$k]))
      elif ($a|type) == "array" and ($b|type) == "array" then
        if ($b|.[0]?) == "$reset" then $b[1:] else $a + $b | uniq end
      else $b end;
    reduce .[] as $item ({}; dm(.; $item))
    | if ($caveman | not) and ((.env.ANTHROPIC_BASE_URL // "") | test("^http://(127\\.0\\.0\\.1|localhost):[0-9]+/w/"))
      then .env.ANTHROPIC_BASE_URL = "https://api.anthropic.com" else . end') \
    || { echo "Failed to merge profiles" >&2; return 1; }
  print -r -- "$merged" >| "$tmpfile"

  # CCP_SETTINGS lets the statusline name the profile and read its effective settings.
  # The config dir override is an env prefix so it applies to this one process only.
  CLAUDE_CONFIG_DIR="$account_dir" CCP_SETTINGS="$tmpfile" "${launcher[@]}" --settings "$tmpfile" "${claude_args[@]}"
}
