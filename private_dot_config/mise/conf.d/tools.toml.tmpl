{{- /* Merges the tools of every enabled module in .chezmoidata/mise.yaml into one [tools] table. */ -}}
{{- $tools := dict -}}
{{- range $module, $spec := .mise.modules -}}
{{-   if $spec.enabled -}}
{{-     range $tool, $version := $spec.tools -}}
{{-       if hasKey $tools $tool -}}
{{-         fail (printf "mise.yaml: tool %q declared in more than one module (second: %s)" $tool $module) -}}
{{-       end -}}
{{-       $_ := set $tools $tool $version -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
# Generated by chezmoi from .chezmoidata/mise.yaml — edit modules there, not this file.

{{ toToml (dict "tools" $tools) -}}
