[Unit]
Description=HyprDynamicMonitors - Prepare monitor config before Hyprland
# Must write monitors.conf before the compositor reads it. Under uwsm the
# pre-compositor stage is graphical-session-pre.target.
Before=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/hyprdynamicmonitors prepare
RemainAfterExit=yes

[Install]
WantedBy=graphical-session-pre.target
