# ============================================================================
# hypridle Configuration — Default (locking) Mode
# ============================================================================
# Official Hyprland idle management daemon
# Documentation: https://wiki.hyprland.org/Hypr-Ecosystem/hypridle/
#
# Started as hypridle.service (systemd user unit), not exec-once.
# Timeouts come from .chezmoidata/globals.yaml (globals.idle.*) — edit there so
# this and hypridle-nolock.conf stay consistent.
#
# Presentation mode (Super+I) does NOT stop this daemon — idle-toggle holds a
# systemd idle inhibitor, which pauses the listeners below while leaving the
# general block armed. No-lock mode (Super+Shift+I) swaps this file for
# hypridle-nolock.conf via the unit's EnvironmentFile.
# ============================================================================

{{ includeTemplate "hypridle_general" . }}
# Listener 1: Lock screen after inactivity
listener {
    timeout = {{ .globals.idle.lock }}
    on-timeout = loginctl lock-session; ~/.local/lib/scripts/core/hook-runner idle-change timeout
    on-resume = ~/.local/lib/scripts/core/hook-runner idle-change resume
}

# Listener 2: Turn off displays after further inactivity
listener {
    timeout = {{ .globals.idle.dpms }}
    on-timeout = hyprctl dispatch dpms off       # Turn off displays
    on-resume = hyprctl dispatch dpms on         # Turn on displays on activity
}
{{- if eq .chassisType "laptop" }}

# Listener 3: Sleep the system (laptop only)
# Desktop systems don't suspend automatically to avoid interrupting long-running tasks
listener {
    timeout = {{ .globals.idle.suspend }}
    on-timeout = ~/.local/lib/scripts/desktop/idle-sleep   # Hibernate if supported, else suspend
}
{{- end }}
