# ============================================================================
# Voice STT - Speech-to-Text Dictation (voxtype)
# ============================================================================
# Push-to-talk: Hold key combo, speak, release to transcribe (text → clipboard)
# Streaming:    Tap to start, tap to stop; text appears live as you speak
#
# SUPER+T        → Cohere    push-to-talk (DEFAULT — #1 Open ASR, multilingual incl. FR)
# SUPER+ALT+T    → Parakeet  streaming toggle (live incremental text, English) [desktop only]
# SUPER+CTRL+T   → Parakeet  push-to-talk (fast English-only alternative) [desktop only]
# SUPER+ALT+M    → Meeting   mode toggle (continuous transcription + Ollama summary)
#
# Engine on SUPER+T is omitted on purpose → uses config default (engine = "cohere").
#
# NOTE: recording start switches to the `voxtype_recording` submap (see
# ../../conf.d/voxtype-submap.conf) to neutralise modifier interference. The
# streaming toggle therefore has a matching stop binding inside that submap.
#
# NOTE: laptop is RAM-constrained and configured for Cohere-only STT (q4f16) —
# see ../../../voxtype/config.toml.tmpl. The two Parakeet bindings below are
# omitted on laptop.
# ============================================================================

# Cohere — default engine, push-to-talk (multilingual, daily driver)
# "voxtype-record" (not "voxtype record") wraps start/toggle so the daemon
# restarts transparently if voxtype-idle-unload.timer stopped it (see
# systemd/user/CLAUDE.md). Stop doesn't need this — it only fires after a
# successful start, so the daemon is already running.
# Full path required: Hyprland's exec dispatcher doesn't see the zsh PATH
# that adds ~/.local/lib/scripts/desktop (see other bindings in this repo).
bindd  = SUPER, T, Start voice dictation (Cohere), exec, ~/.local/lib/scripts/desktop/voxtype-record start
binddr = SUPER, T, Stop voice dictation (Cohere), exec, voxtype record stop

{{ if ne .chassisType "laptop" -}}
# Parakeet — streaming dictation, toggle (live incremental text, English) — desktop only
bindd  = SUPER ALT, T, Toggle streaming dictation (Parakeet), exec, ~/.local/lib/scripts/desktop/voxtype-record toggle

# Parakeet — fast English-only push-to-talk — desktop only
bindd  = SUPER CTRL, T, Start voice dictation (Parakeet), exec, ~/.local/lib/scripts/desktop/voxtype-record start --model parakeet-tdt-0.6b-v3
binddr = SUPER CTRL, T, Stop voice dictation (Parakeet), exec, voxtype record stop

{{ end -}}
# Meeting mode — continuous transcription with speaker diarization + AI summary
bindd  = SUPER ALT, M, Toggle meeting transcription, exec, ~/.local/lib/scripts/desktop/voice-meeting toggle
