# ============================================================================
# System Control
# ============================================================================
# System-level operations: lock, power, help, menus.
# ============================================================================

# Lock screen: Super + L
bindd = SUPER, L, Lock screen, exec, ~/.local/lib/scripts/desktop/immediate-lock

{{ if not .features.quickshell_shell.enabled -}}
# Power menu: Super + Shift + Q
# Gated: with the Quickshell shell on, conf.d/quickshell.conf claims this key
# for the Quickshell power menu. Duplicate binds STACK in Hyprland -- both
# would fire -- so the old one has to be gated off, not merely shadowed.
bindd = SUPER SHIFT, Q, Power menu, exec, ~/.local/lib/scripts/desktop/wlogout
{{ end }}

# Main system menu: Super + Space
# Provides access to all system functions
bindd = SUPER, Space, Main system menu, exec, ~/.local/lib/scripts/user-interface/system-menu

# Notification center: Super + Shift + N
bindd = SUPER SHIFT, N, Notification center, exec, swaync-client --toggle-panel

# Keybinding cheatsheet: Super + /
# Displays all active keybindings dynamically from hyprctl
bindd = SUPER, slash, Keybinding help, exec, ~/.local/lib/scripts/desktop/keybindings
