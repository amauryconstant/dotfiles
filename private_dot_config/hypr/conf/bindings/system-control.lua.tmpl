-- ============================================================================
-- System Control
-- ============================================================================
-- System-level operations: lock, power, help, menus.
-- ============================================================================

o.bind("SUPER + L", "Lock screen", "~/.local/lib/scripts/desktop/immediate-lock")
{{ if not .features.quickshell_shell.enabled -}}
-- Gated: with the Quickshell shell on, conf.d/quickshell.lua claims this key.
-- Duplicate binds STACK in Hyprland, so the old one is gated off, not shadowed.
o.bind("SUPER + SHIFT + Q", "Power menu", "~/.local/lib/scripts/desktop/wlogout")
{{ end -}}
o.bind("SUPER + Space", "Main system menu", "~/.local/lib/scripts/user-interface/system-menu")
{{ if and .features.quickshell_shell.enabled .features.quickshell_notifications.enabled -}}
-- Phase 4 owns the notification daemon: swaync is MASKED by
-- run_onchange_after_configure_notifications, so swaync-client would talk to
-- nothing. Both alternatives live here rather than in conf.d/quickshell.lua,
-- because a .lua drop-in cannot carry template actions and this key is gated on
-- a different flag than the bar is.
o.bind("SUPER + SHIFT + N", "Notification center", "~/.local/lib/scripts/desktop/quickshell-toggle notifications")
{{ else -}}
o.bind("SUPER + SHIFT + N", "Notification center", "swaync-client --toggle-panel")
{{ end -}}
-- Both routes read the same hyprctl output; only the drawing differs. The shell
-- draws a document, which is what surface 9 asks for; the script's own picker
-- stays as the fallback, because with the shell down there is nothing else.
{{ if .features.quickshell_shell.enabled -}}
o.bind("SUPER + slash", "Keybinding help", "~/.local/lib/scripts/desktop/quickshell-toggle keybindings")
{{ else -}}
o.bind("SUPER + slash", "Keybinding help", "~/.local/lib/scripts/desktop/keybindings")
{{ end -}}
