-- ============================================================================
-- Application Launchers
-- ============================================================================
-- Quick access to frequently used applications.
-- Some use launch-or-focus pattern for single-instance behavior.
-- ============================================================================

-- Terminal: Super + Return (opens in current working directory)
o.bind(
	"SUPER + Return",
	"Launch terminal in CWD",
	"{{ .globals.applications.terminal }} --working-directory=$(~/.local/lib/scripts/terminal/terminal-cwd)"
)

-- File manager: Super + E (launch-or-focus for single-instance)
o.bind("SUPER + E", "File manager", "~/.local/lib/scripts/desktop/launch-or-focus thunar")

-- Web browser: Super + W
o.bind("SUPER + W", "Web browser", "~/.local/lib/scripts/desktop/firefox-open")

-- Neovim session picker: Super + O
o.bind("SUPER + O", "Neovim session picker", "ghostty -e ~/.local/lib/scripts/terminal/ghostty-sessionizer")
