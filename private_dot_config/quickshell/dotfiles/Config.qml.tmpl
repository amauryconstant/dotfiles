pragma Singleton

import Quickshell

Singleton {
    id: root

    // 🚨 THREE radii, and design page Shell-02-Geometry is explicit that radii
    // are NOT on the density ramp. The four-step ramp this file used to carry
    // (12 / 10 / 8 / 6, plus a fifth at 14 on the power tiles) was inventing
    // distinctions no surface needs: a tooltip and a chip are the same kind of
    // thing, and a power tile is a surface.
    readonly property int radiusPanel: 12
    readonly property int radiusChip: 8
    // Larger than any element it is applied to, which is how a pill stays a
    // pill at every height without recomputing the radius.
    readonly property int radiusPill: 999

    // 1px hairlines: borders, separators, dividers.
    readonly property int hairline: 1

    readonly property int gap: 8
    readonly property int padTight: 12
    readonly property int pad: 16
    readonly property int padLoose: 24

    // A list row: popover, menu, notification centre. The launcher's rows are
    // taller because they carry two lines — see launcherRowHeight.
    readonly property int rowH: 34
    // A section label inside a list, not a row: it carries fontMeta text, has
    // no hit target and cannot be selected, so it is off the row scale and owes
    // nothing to hitMin.
    readonly property int menuSectionHeight: 24
    // 🚨 A pointer fact, not a density preference, so it does NOT scale with
    // anything else here. A widget whose paint is smaller than this still
    // claims 32 of pointer space; chips sit `gap` apart, so two 32px hit areas
    // on adjacent 26px chips are 34 apart and never overlap.
    readonly property int hitMin: 32

    // Motion. Three durations and nothing between them. NEVER animated: text
    // replacing text (a title, a percentage, a date), the focus ring, and
    // anything whose only change is a colour role — which is why a live theme
    // switch repaints with no transition at all.
    readonly property int motionFast: 120
    readonly property int motionSlow: 180
    readonly property int motionEnter: 220

    // The bar floats: it is 40 tall, inset 4 on every side — matching
    // Hyprland's gaps_out (conf/general.lua) so the bar's edges line up with
    // every window's. Waybar's 30px full-bleed bar cannot coexist with that,
    // which is why this restructure is what ends the Phase 1 A/B.
    //
    // 🚨 barInset and gaps_out are ONE number in two files, and the gap BELOW
    // the bar is barInset + gaps_out (8) — the compositor adds the margin on
    // top of the exclusive zone, see Bar.qml. So changing one without the other
    // both misaligns the bar's side edges and moves the gap under it.
    readonly property int barHeight: 40
    readonly property int barInset: 4
    // Icon buttons at rest, and the height of a workspace pill.
    readonly property int chipSize: 26
    readonly property int pillHeight: 24
    readonly property int iconSize: 16
    // ponytail: the design's named overflow order (date drops, then the title
    // shrinks to titleMinW and drops, then the meter loses its readout, then
    // the tray folds, then workspaces collapse to the focused pill) is NOT
    // implemented. It is driven by output width, and no output this repo drives
    // is narrow enough to reach the first breakpoint — so it could be neither
    // observed nor tested, and the breakpoints themselves would be invented
    // numbers. The two steps that DO fire are built: the title's pixel bound
    // below, and trayMaxItems. Add the driver when a narrow output exists.

    // Window-title bounds. 🚨 These replace a titleMaxLength of 50 CHARACTERS,
    // which does not bound pixels at all: "WWWW…" is roughly three times the
    // width of "iiii…", so a character cap either wraps the bar or wastes half
    // of it depending on the title. Width plus Text.elide is the only cap that
    // means anything.
    readonly property int titleMinW: 100
    readonly property int titleMaxW: 260

    // Volume/brightness OSD. It sits bottom-centre, clear of voxtype's own OSD
    // (a 72-tall card at bottomMargin 72) so a dictation card and a volume key
    // cannot overlap.
    // Fixed 200x96 whatever the payload: a readout that resizes as the number
    // crosses 100 draws the eye to the wrong thing.
    readonly property int osdWidth: 200
    readonly property int osdHeight: 96
    readonly property int osdMargin: 160
    readonly property int osdTrackWidth: 152
    readonly property int osdTrackHeight: 6
    readonly property int osdHideMs: 1500

    // Type — the whole scale, and nothing outside it is drawn. A seventh size
    // is a sign that an element wants a job one of these already has.
    //
    // 🚨 QML's font.pixelSize is an INTEGER, so the design's half-pixel steps
    // round here: meta 10.5 -> 11, title 13.5 -> 14. That is a QML constraint,
    // not a reading of the design; font.pointSize would take the fraction but
    // then every size in the tree would be in a different unit from every
    // geometry value.
    // The section label above a group of rows. 9.5 in the design, and the only
    // step below fontMeta; it is drawn in the terminal face, in caps, and
    // design page 06 says it appears in popovers and nowhere else.
    readonly property int fontSection: 10
    readonly property int fontMeta: 11
    readonly property int fontBody: 12
    readonly property int fontTitle: 14
    // The OSD readout, and the only display size in the shell.
    readonly property int fontDisplay: 20

    // Glyphs are sized separately from text, and there are exactly four. A
    // seven-step ramp is only legible at glyphOsd; at glyphBar it is not, which
    // is why three steps are the rule everywhere else.
    readonly property int glyphRow: 13
    readonly property int glyphBar: 16
    readonly property int glyphOsd: 28
    readonly property int glyphTile: 32

    // Launcher, design page Shell-05-Launcher. The panel grows downward from
    // the input row, so only the row heights are fixed; the window height
    // follows the results. 340 wide, matching popMaxW: it is the same kind of
    // surface as a popover, and the old 760 came from an artboard that no
    // longer exists.
    readonly property int launcherWidth: 340
    readonly property int launcherInputHeight: 48
    // Taller than rowH because each launcher row carries two lines.
    readonly property int launcherRowHeight: 48
    readonly property int launcherIconSize: 20
    readonly property int launcherFooterHeight: 32
    readonly property int launcherListPad: 6
    // The canvas draws three rows. A cap is still needed for a one-letter
    // query, and eight is what fits without the panel becoming a window.
    readonly property int launcherMaxResults: 8

    // Panel bounds shared by every list surface. popMaxH is CHOSEN, not
    // computed, and the row budget follows from it: 420 - 34 header - 32 footer
    // leaves 354, which holds 8 rows of 34 with 7 gaps of 8 = 328. A ninth
    // needs 370 and overflows, so the list scrolls.
    readonly property int popMinW: 300
    readonly property int popMaxW: 340
    readonly property int popMaxH: 420

    // Popovers, design page Shell-06-Popovers. One chrome, seven payloads: a
    // 34 header carrying glyph and title, the payload, and a 32 footer with the
    // keys on the left and the escape hatch on the right. Width and height come
    // from the three bounds above, which the launcher shares.
    readonly property int popHeaderHeight: 34
    readonly property int popFooterHeight: 32
    // The slider is the only place in the shell where drag and the wheel both
    // exist. The thumb is larger than the track on purpose: the track reports a
    // value, the thumb is what a pointer has to hit.
    readonly property int popSliderTrack: 6
    readonly property int popSliderThumb: 16
    // 🚨 2px OUTSIDE the paint and never animated (Theme.focusRing). Drawn only
    // where the surface traps the keyboard, which for a popover means only when
    // it was opened from the submap rather than by pointer.
    readonly property int popRingWidth: 2
    // 🚨 Pointer-opened popovers take NO keyboard grab, so nothing tells the
    // shell about a click landing elsewhere -- see BarPopover.qml. Losing the
    // pointer is therefore the close signal, and it needs the same slack the
    // dock needs for the same reason: crossing from the widget to the surface
    // below it passes through a moment where neither reports hover.
    readonly property int popHideDelayMs: 260

    // Power menu, design page Shell-09-Session. 14 is the canvas's own tile radius and sits
    // between radiusPanel and radiusTile deliberately — the tiles are much
    // larger than either, so the four-step ramp does not reach them.
    // 🚨 Six tiles, not the design's five: hibernate does real work on this
    // laptop, and the design's own rule — "a control that would do nothing is
    // removed, not disabled" — endorses keeping one that works. The tiles stay
    // at 124 for the same reason: 88 was drawn for a five-tile row.
    readonly property int powerTileSize: 124
    readonly property int powerTileGap: 14
    readonly property int powerColumnGap: 30
    readonly property int powerAvatarSize: 34

    // Polkit dialog, surface §21. Same width as the launcher and a
    // notification card: this is another panel of stacked full-width rows, and
    // the one number the geometry scale does not supply is how wide a panel is.
    readonly property int polkitDialogWidth: 340

    // Keybindings sheet, surface §9. A panel measurement again, and the one
    // surface here that is a DOCUMENT rather than a chooser: 115 rows have to
    // be scannable, so it is two columns wide rather than a 340 list. Capped
    // rather than fixed -- it takes the lesser of this and the output, so a
    // short list does not draw a mostly-empty panel.
    readonly property int sheetWidth: 900
    readonly property real sheetMaxHeightFraction: 0.82
    // The chord column. Fixed so every description starts on the same x in
    // both columns, which is the whole reason a table beats a list here.
    readonly property int sheetKeysWidth: 190

    // Lock screen, surface §22. Panel measurements, which the density scale
    // does not supply -- like polkitDialogWidth.
    //
    // 🚨 The lock is the one FULL-SCREEN surface, and the scale is calibrated
    // for a 40px bar and 340px panels. Design page 12's 220x34 field reads as a
    // popover control dropped onto a 1920x1080 ground: correct against the
    // scale, wrong against the surface. So the field is sized for the surface
    // it is on, and the clock takes a step above fontDisplay for the same
    // reason -- there is no other display-sized thing on screen to be
    // consistent with. Everything else there still comes from the scale.
    readonly property int lockFieldWidth: 360
    readonly property int lockFieldHeight: 56
    readonly property int lockClockSize: 72

    // How far the lock dims the wallpaper it draws. NOT scrimOpacity (0.86):
    // that value exists to hide a desktop behind a modal, and at it the
    // wallpaper is barely there. This is the calibration knob for the one thing
    // a fixed number cannot guarantee -- legible text over an ARBITRARY image.
    // Raise it if a pale wallpaper ever washes the clock out.
    readonly property real lockDimOpacity: 0.7

    // Dock, design page Shell-04-Bar (dock: no page in the current set). Deliberately OUTSIDE the geometry scale, the same
    // way powerTileRadius is: the scale exists so nested surfaces read as
    // nested, and the dock is a PEER of the bar, not something inside it.
    // Every value here is measured off the artboard rather than transcribed --
    // Amendment A had the padding, the tile radius and the gap all wrong.
    // Off. Tried in daily use 2026-09-02 and not wanted: the bar's launcher
    // chip and SUPER+D already cover launching, so the dock was a second way
    // to do one thing. Flip to true to get it back — nothing else changes.
    readonly property bool dockEnabled: false
    readonly property int dockHeight: 66
    readonly property int dockRadius: 16
    readonly property int dockPad: 14
    readonly property int dockGap: 10
    readonly property int dockTileSize: 42
    readonly property int dockTileRadius: 12
    readonly property int dockIconSize: 19
    // The reveal strip. 4px is enough to catch a mouse thrown at the edge and
    // small enough that it never intercepts a click meant for a window.
    readonly property int dockHotEdge: 4
    readonly property int dockRevealMs: 180
    // Grace period before hiding. caelestia's drawers get away with none
    // because their hit regions are exhaustive coordinate math; a dock built
    // from real child MouseAreas wants the slack, and every dock people
    // actually like (macOS, Plank, Dash-to-Dock) has one.
    readonly property int dockHideDelayMs: 220
    // Running indicator. Kept against the artboard, which draws none: without
    // it the dock is a strictly worse SUPER+D. See Amendment E.
    readonly property int dockIndicator: 4

    // Pinned dock entries, as DESKTOP-ENTRY IDS for DesktopEntries.byId().
    //
    // 🚨 Deliberately NOT interpolated from globals.yaml applications, which
    // holds binary and MIME names rather than desktop ids: `ghostty` is
    // `com.mitchellh.ghostty.desktop` and `org.xfce.thunar` is `thunar.desktop`,
    // so two of the four would resolve to null. DesktopEntries.heuristicLookup()
    // does not close the gap either -- it falls back to StartupWMClass, which is
    // `com.mitchellh.ghostty` for the one and absent for the other.
    readonly property var dockApps: ["com.mitchellh.ghostty", "firefox", "thunar", "nvim"]
    // md-view_grid(0xf0570) -- the trailing "all apps" tile, which opens the
    // same launcher SUPER+D does.
    readonly property string dockLauncherGlyph: "󰕰"

    // Workspace overview, no page in the current design set. A carousel, not a grid: the focused
    // workspace stays legible at real proportions while neighbours are
    // peripheral context.
    //
    // Off, like the dock, and declined the same way — tried in daily use
    // 2026-09-02 and not wanted. Re-enabling needs BOTH this flag and the
    // SUPER+grave binding restored to hypr/conf.d/quickshell.{lua,conf}; the
    // drop-ins are plain files, so a line in them cannot be template-gated.
    readonly property bool overviewEnabled: false
    //
    // The artboard draws three DIFFERENT card aspect ratios (0.81/0.68/0.59),
    // none of which is a screen, so its cards cannot host a truthful window
    // layout. Ours take the monitor's own aspect and apply the artboard note's
    // falloff curve instead. See Amendment E.
    readonly property var overviewCardScale: [1.0, 0.69, 0.46]
    readonly property var overviewCardOpacity: [1.0, 0.6, 0.35]
    readonly property int overviewGap: 28
    // 520/1920 on the artboard canvas -- the focused card's share of the width.
    readonly property real overviewFocusedFraction: 0.27
    readonly property int overviewCardRadius: 14
    readonly property int overviewFooterHeight: 44
    readonly property int overviewTitleBarHeight: 22
    readonly property int overviewDotSize: 8
    readonly property int overviewDotActiveWidth: 22
    // Scrim depth, shared by every surface that dims what is behind it.
    // Applied to Theme.scrim (a shade, not a theme colour — see the note
    // there), so it reads the same in a light theme as in a dark one. 0.86 over
    // a BACKGROUND TOKEN was the old figure and rendered nearly white on latte
    // and rose-pine-dawn. It needs to be this deep: the scrim composites over
    // the wallpaper, and a thinner one leaves the ground wallpaper-dependent,
    // which no fixed foreground can be legible against.
    readonly property real scrimOpacity: 0.86

    // Notifications, design page Shell-07-Notifications. The centre and the popup stack share one
    // card component, so they share its metrics; only the surface around it
    // differs. Radii, paddings and font sizes all come from the scale above —
    // the canvas's 10px body padding is padTight - 2, which is close enough
    // that inventing an eighth padding step would cost more than it buys.
    readonly property int notifWidth: 340
    readonly property int notifHeaderHeight: 52
    readonly property int notifFooterHeight: 38
    readonly property int notifBadgeHeight: 19
    readonly property int notifGroupBadgeHeight: 16
    readonly property int notifActionHeight: 28
    readonly property int notifIconSize: 12
    // An image payload replaces the glyph chip in the same slot, so a card with
    // one is the same shape as a card without. Decoded AT this size — a
    // screenshot notification that stalls the shell for a 4K decode is worse
    // than no thumbnail at all.
    readonly property int notifThumbSize: 38
    readonly property int notifListPad: 10
    // Popups reuse notifWidth so a toast and its history card are the same
    // object at the same size — the toast is not a second, narrower design.
    readonly property int notifPopupMargin: 8
    // Beyond this the stack stops being readable and starts being a wall; the
    // overflow is already in history, which is where it belongs.
    readonly property int notifPopupMaxVisible: 3
    // 5s normal, 3s low, critical never. Shorter than the swaync config these
    // replaced (10s/5s) because an expired popup is not gone — it moves to the
    // centre, which is the whole difference between dismissing and ignoring.
    readonly property int notifTimeoutMs: 5000
    readonly property int notifTimeoutLowMs: 3000
    // How many entries the centre keeps. UPSTREAM DOES NOT CAP THIS: the
    // server tracks every notification until something dismisses it, so an
    // uncapped centre grows for as long as the session does.
    readonly property int notifHistoryMax: 100
    // Taller than popMaxH: the centre is a list the user came to read, not a
    // panel they glanced at.
    readonly property int notifCentreMaxHeight: 620

    // Scroll step for the audio widget, as a fraction. Waybar shelled out to
    // `pamixer -i 5`; Pipewire volume is a 0..1 float.
    readonly property real volumeStep: 0.05

    // Fonts come from .chezmoidata/globals.yaml so the QML tree cannot drift
    // from GTK/Qt/Waybar/Wofi/Hyprlock.
    // The terminal the launcher's `:` run mode opens a command in. From
    // globals.yaml for the same reason the fonts are: so the QML tree cannot
    // drift from what every other consumer of that file thinks the terminal is.
    readonly property string terminal: "{{ .globals.applications.terminal }}"

    readonly property string guiFont: "{{ .globals.guiFont }}"
    readonly property string terminalFont: "{{ .globals.terminalFont }}"

    // Window class to Nerd Font glyph, for the workspace pills. Keys are
    // matched as a substring of the lowercased class, so a reverse-DNS class
    // (com.mitchellh.ghostty) and a bare one (firefox) both resolve from one
    // short key — no second entry per packaging format.
    readonly property var windowGlyphs: ({
            firefox: "󰈹",
            ghostty: "󰆍",
            thunar: "󰉋",
            slack: "󰒱",
            spotify: "󰓇",
            obsidian: "󰎚",
            steam: "󰓓",
            localsend: "󰒖",
            qbittorrent: "󰇚",
            easyeffects: "󰺢",
            satty: "󰋩"
        })
    // An unknown class renders something rather than nothing, so the map can
    // rot without the pills going blank.
    readonly property string windowGlyphFallback: "󰣆"

    // Level ramps rendered by TWO surfaces (a bar widget and the OSD), so they
    // live here rather than in the widget. A glyph that only distinguishes one
    // widget's own states stays in that widget -- see Amendment A's re-stated
    // exit criterion in the frozen _plans/archive/QUICKSHELL_SHELL.md.
    readonly property var volumeGlyphs: ["󰕿", "󰖀", "󰕾"]
    readonly property string volumeGlyphMuted: "󰝟"
    readonly property string volumeGlyphHeadset: "󰋎"
    readonly property string volumeGlyphHeadphone: "󰋋"
    // Wifi signal, wired route, and no route at all. Hoisted out of
    // NetworkWidget when the network popover started drawing the same ramp:
    // a glyph set that distinguishes ONE widget's states belongs to that
    // widget, but this one now has two consumers.
    readonly property var wifiGlyphs: ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"]
    readonly property string wiredGlyph: "󰈀"
    readonly property string noNetworkGlyph: "󰖪"
    // md-brightness_1..7 -- a seven-step ramp because that is how many the icon
    // set actually has.
    readonly property var brightnessGlyphs: ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"]
    // Tray items past this fold behind the overflow glyph — the same cap the
    // launcher's result list uses.
    readonly property int trayMaxItems: 8
    // The meter raises a tint under its number past these, rather than
    // colouring the digits. No design figure exists; these are the usual
    // "busy" and "in trouble" marks and are the knob to turn if they nag.
    readonly property int meterWarnPercent: 80
    readonly property int meterCriticalPercent: 90

    // The night-light slider's range and its notch. 3500-6500 is exactly the
    // span the preset list in desktop/nightlight-config already offered, so a
    // continuous control reaches nothing the picker could not; 100K is a step
    // the eye can just tell apart. The script accepts 1000-20000 and keeps
    // validating that, because it is also reachable from a shell.
    readonly property int nightlightMinK: 3500
    readonly property int nightlightMaxK: 6500
    readonly property int nightlightStepK: 100
    // What the slider shows before the preference file has been read, and the
    // same value nightlight-toggle falls back to.
    readonly property int nightlightDefaultK: 4000

    // 🚨 Written from explicit codepoints, never pasted. A Nerd Font glyph
    // literal can be authored as an empty string — valid QML, valid string,
    // nothing rendered and no error anywhere — and it has shipped that way in
    // this tree twice. Verified present in GeistMono Nerd Font before use.
    // md-alert(0xf0026) — a critical notification's chip glyph. Severity is
    // carried by the glyph CHANGING plus its tint, never by a title colour:
    // signalError as text measures 2.81 at worst and is banned.
    // md-memory(0xf035b) — the bar's single load readout.
    // md-weather_sunset(0xf059a) — the night-light popover's own glyph, the
    // same one desktop/nightlight-indicator draws in the bar. NOT omarchy's
    // 0xf050e, which is slashed and reads as "disabled".
    // md-weather_sunny(0xf0599) — the row that turns the filter off.
    readonly property string nightlightGlyph: "󰖚"
    readonly property string nightlightOffGlyph: "󰖙"
    readonly property string meterGlyph: "󰍛"
    readonly property string notifCriticalGlyph: "󰀦"
    // fa-picture_o(0xf03e) — the placeholder when an image payload fails to
    // decode, and the marker on an image entry.
    readonly property string imageGlyph: ""
    // md-dots_horizontal(0xf0d7) — tray overflow past the 8-item cap.
    readonly property string overflowGlyph: ""
    // md-volume_variant_off(0xf0ac0) — the failed-service case for audio.
    // A failed service SHOWS, with a label; only absent hardware hides.
    readonly property string audioFailedGlyph: "󰫀"
    // md-magnify(0xf0349) / md-console(0xf018d) / md-calculator(0xf00ec) --
    // the launcher header at rest, and the two prefix modes. Centralised here
    // rather than inline because PickerSurface is shared by three surfaces and
    // a glyph literal in a QML file is the one thing no linter checks.
    readonly property string searchGlyph: "󰍉"
    readonly property string terminalGlyph: "󰆍"
    readonly property string calcGlyph: "󰃬"
    // md-clipboard_text_outline(0xf0c5) -- the clipboard picker header.
    readonly property string clipboardGlyph: ""
    // md-menu(0xf035c) -- a script-driven menu's header.
    readonly property string menuGlyph: "󰍜"

    // The four bell states, rendered by the bar widget AND the notification
    // centre's DND button -- so they live here by the same rule as the ramps
    // above. Keys are <dnd?>-<unread?>, the same four combinations the swaync
    // module they replace reported through `swaync-client -swb`.
    // md-bell(0xf009a) / md-bell_ring(0xf009b) / md-bell_outline(0xf009c) /
    // md-bell_off_outline(0xf0a91).
    readonly property var notifGlyphs: ({
            notification: "󰂚",
            none: "󰂜",
            "dnd-notification": "󰂛",
            "dnd-none": "󰪑"
        })

    // Widgets that shell out reach our script library through this, resolved
    // at runtime like Theme's colors.sh path rather than baked in by the
    // template, so the rendered QML stays free of an absolute home path.
    readonly property string scriptsDir: `${Quickshell.env("HOME")}/.local/lib/scripts`

    // Chassis-dependent widgets (battery, power profile, backlight) gate on
    // this ONE property. Deliberately not eight separate .tmpl widgets.
    readonly property bool isLaptop: {{ eq .chassisType "laptop" }}

    // 🚨 Whether this shell owns org.freedesktop.Notifications. Load-bearing,
    // not cosmetic: a bus name has ONE owner, so merely instantiating
    // NotificationServer takes it. With the flag off, swaync is unmasked and
    // instantiating anyway would make the two race for the name at login —
    // exactly the state the rollback exists to avoid. See
    // .chezmoiscripts/run_onchange_after_configure_notifications.sh.tmpl.
    readonly property bool notificationsOwned: {{ .features.quickshell_notifications.enabled }}

    // 🚨 Whether this shell owns the polkit authentication agent. Same kind of
    // exclusivity as notificationsOwned and load-bearing for the same reason: a
    // session may have exactly ONE agent, and merely CONSTRUCTING PolkitAgent
    // registers it. With the flag off, hypr/conf.d/polkit-gnome deploys the
    // polkit-gnome agent instead and this shell must not construct one.
    readonly property bool polkitOwned: {{ .features.quickshell_polkit.enabled }}

    // Whether this shell draws the lock screen. NOT the same kind of flag as
    // the two above: nothing is displaced and nothing races, because
    // desktop/immediate-lock asks the running shell at RUNTIME and falls back
    // to hyprlock when the answer is not "ok". So this only decides whether the
    // WlSessionLock is constructed at all; the `lock` IPC target is registered
    // either way and answers "disabled", which is what keeps a switched-off
    // feature distinguishable from a broken wiring.
    readonly property bool lockOwned: {{ .features.quickshell_lock.enabled }}

    function brightnessGlyph(percent: int): string {
        return root.brightnessGlyphs[Math.min(6, Math.floor(percent / 15))];
    }

    function volumeGlyph(volume: real, muted: bool, formFactor: string): string {
        if (muted)
            return root.volumeGlyphMuted;
        if (formFactor === "headset")
            return root.volumeGlyphHeadset;
        if (formFactor === "headphone")
            return root.volumeGlyphHeadphone;
        return root.volumeGlyphs[volume < 0.34 ? 0 : volume < 0.67 ? 1 : 2];
    }

    function windowGlyph(windowClass: string): string {
        const lower = (windowClass ?? "").toLowerCase();
        const key = Object.keys(root.windowGlyphs).find(k => lower.includes(k));
        return key ? root.windowGlyphs[key] : root.windowGlyphFallback;
    }
}
