#!/usr/bin/env bash

# Firefox launcher - NVIDIA EGL-on-Wayland deadlock workaround
# Purpose: Keep Firefox mapped, GPU-accelerated and unfrozen under native Wayland
# Requirements: Arch Linux, firefox (also serves firefox-esr via symlink)
#
# Stock egl-wayland2 (09_nvidia_wayland2.json, which sorts first) deadlocks Firefox on
# its first frame: the window is created and configured but never maps. The legacy
# egl-wayland platform avoids that, then deadlocks later instead, when an extension
# popup (Bitwarden) creates a new EGL surface. Same bug, two symptoms.
#
# Cause (stack-sampled with eu-stack, WAYLAND_DEBUG trace; 2026-10-14): the Renderer
# thread blocks in egl-wayland2's WaitForPreviousFrames (eplWlSwapBuffers), waiting for
# presentation feedback on the EGL subsurface. The compositor never answers for a
# subsurface whose parent toplevel is not mapped yet, and the parent can only be mapped
# by Firefox's GTK main thread, which is itself blocked waiting for the Renderer.
#
# Fix: a private build of egl-wayland2 whose wait is bounded
# (.patches/egl-wayland2-bounded-frame-wait.patch, built by
# .chezmoiscripts/run_after_build_egl_wayland2_patched.sh.tmpl). This launcher
# points the EGL platform config at that build, for Firefox only. Everything else on the
# system keeps the packaged library. Full record: _research/FIREFOX_NVIDIA_EGL_DEADLOCK.md.
#
# Fallback when the patched build is missing (failed build, fresh install before the
# script ran): XWayland. It has no such wedge but renders text soft on scaled monitors,
# since Hyprland stretches the 1x X window. Sharp XWayland (xwayland:force_zero_scaling)
# leaves the right part of the window unclickable, so it is not an option.
#
# FIREFOX_BACKEND=x11 forces the XWayland fallback.
#
# Config dir is rebuilt on every launch, so driver updates are picked up automatically.

EGL_CONFIG_DIR=/usr/share/egl/egl_external_platform.d
WAYLAND2_CONFIG="$EGL_CONFIG_DIR/09_nvidia_wayland2.json"
PATCHED_LIB="$HOME/.local/lib/egl-wayland2-patched/lib/libnvidia-egl-wayland2.so.1"

case "${0##*/}" in
firefox-esr) FIREFOX_BIN=/usr/lib/firefox-esr/firefox-esr ;;
*) FIREFOX_BIN=/usr/lib/firefox/firefox ;;
esac

use_x11() {
    export MOZ_ENABLE_WAYLAND=0
    export GDK_BACKEND=x11
}

if [[ -e "$WAYLAND2_CONFIG" ]]; then
    if [[ "${FIREFOX_BACKEND:-}" == x11 || ! -e "$PATCHED_LIB" ]]; then
        use_x11
    else
        platform_dir="${XDG_RUNTIME_DIR:-/tmp}/firefox-egl-platforms"

        if mkdir -p "$platform_dir" 2>/dev/null; then
            rm -f "$platform_dir"/*.json

            # Every platform except the packaged wayland ones...
            for config in "$EGL_CONFIG_DIR"/*.json; do
                [[ -e "$config" ]] || continue
                case "${config##*/}" in
                *wayland*) continue ;;
                *) ;;
                esac
                ln -sf "$config" "$platform_dir/"
            done

            # ...plus wayland2, pointed at the patched library
            cat >"$platform_dir/09_nvidia_wayland2.json" <<EOF
{
    "file_format_version" : "1.0.0",
    "ICD" : { "library_path" : "$PATCHED_LIB" }
}
EOF
            export __EGL_EXTERNAL_PLATFORM_CONFIG_DIRS="$platform_dir"
        else
            use_x11
        fi
    fi
fi

exec "$FIREFOX_BIN" "$@"
