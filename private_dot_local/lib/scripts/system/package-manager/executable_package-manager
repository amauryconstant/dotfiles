#!/usr/bin/env bash

# Package Manager - declarative install/remove for Arch + Flatpak, driven by chezmoi
# Purpose: sync a declared package set (removing what was declared before and no longer is),
#          update with the AUR supply-chain tripwire, approve changed PKGBUILDs
# Requirements: Arch Linux, paru, yq, flatpak (UI library optional)

# Source UI library (check if already sourced to avoid readonly variable conflicts)
if ! declare -F ui_title >/dev/null 2>&1; then
	if [[ -n "${UI_LIB:-}" && -f "$UI_LIB" ]]; then
		# shellcheck source=/dev/null
		. "$UI_LIB"
	elif [[ -f "$HOME/.local/lib/scripts/core/gum-ui.sh" ]]; then
		# shellcheck source=/dev/null
		. "$HOME/.local/lib/scripts/core/gum-ui.sh"
	else
		echo "Error: UI library not found" >&2
		exit 1
	fi
fi

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

# Overridable so the dry-run can be tested against a scratch state
STATE_DIR="${PACKAGE_MANAGER_STATE_DIR:-$HOME/.local/state/package-manager}"
# shellcheck disable=SC2034  # used by lib/sync.sh
APPLIED_FILE="$STATE_DIR/applied.txt"
mkdir -p "$STATE_DIR"

# shellcheck source=lib/tripwire.sh
. "$SCRIPT_DIR/lib/tripwire.sh"
# shellcheck source=lib/sync.sh
. "$SCRIPT_DIR/lib/sync.sh"
# shellcheck source=lib/update.sh
. "$SCRIPT_DIR/lib/update.sh"
# shellcheck source=lib/approve.sh
. "$SCRIPT_DIR/lib/approve.sh"

usage() {
	cat <<'EOF'
Usage: package-manager <command>

  sync <declared-file> [--dry-run]   install the declared set, remove packages
                                     declared last time but not now (chezmoi calls this)
  update [--no-flatpak]              tripwire-gated system + Flatpak update
  approve <pkg>... | --all | --seed  review + approve AUR PKGBUILD changes

<declared-file>: one package per line, `flatpak:` prefix for Flatpak.
EOF
}

main() {
	local cmd="${1:-}"
	[[ $# -gt 0 ]] && shift
	case "$cmd" in
	sync) cmd_sync "$@" ;;
	update) cmd_update "$@" ;;
	approve) cmd_approve "$@" ;;
	help | -h | --help | "") usage ;;
	*)
		echo "Unknown command: $cmd" >&2
		usage >&2
		return 1
		;;
	esac
}

main "$@"
