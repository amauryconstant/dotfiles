#!/usr/bin/env sh

# Script: theme-menu
# Purpose: Interactive theme selector
# Requirements: Arch Linux, quickshell-menu, theme-switcher, jaq
# Usage: theme-menu [--print-items]
#
# Rows are sent as JSON objects rather than as one packed string per line, so
# the glyph lands in the picker's icon column, the current theme is marked with
# a badge instead of a shifting "✓ " prefix, and the slug travels as `payload`
# where the user never sees it and the fuzzy match never hits it. See
# desktop/quickshell-menu for the item shape.
#
# --print-items writes the item JSON and exits: the grouping, the ordering and
# the badge are testable without a display.

# Source environment to get SCRIPTS_DIR
if [ -f "$HOME/.config/shell/env" ]; then
    . "$HOME/.config/shell/env"
fi

# Fallback if SCRIPTS_DIR not set
SCRIPTS_DIR="${SCRIPTS_DIR:-$HOME/.local/lib/scripts}"

THEMES_DIR="$HOME/.config/themes"
THEME_SWITCHER="$SCRIPTS_DIR/desktop/theme-switcher"
TAB=$(printf '\t')

CURRENT_THEME=$("$THEME_SWITCHER" current --slug)

# The FALLBACK mark for a theme with no icon.png, and the only thing the Wofi
# path can draw. Presentation, so it stays here — unlike the dark/light arm,
# which theme-switcher owns.
theme_glyph() {
    case "$1" in
        catppuccin-latte)
            printf '󰛊' # md-coffee_outline
            ;;
        catppuccin-mocha)
            printf '󰅶' # md-coffee
            ;;
        rose-pine-dawn)
            printf '' # md-weather-sunrise
            ;;
        rose-pine-moon)
            printf '󰖚' # md-weather-sunset
            ;;
        gruvbox-light | gruvbox-dark)
            printf '󰏗' # md-package_variant_closed
            ;;
        solarized-light)
            printf '' # fa-sun
            ;;
        solarized-dark)
            printf '' # fa-moon
            ;;
        *)
            printf '󰏘' # md-palette
            ;;
    esac
}

# The theme's own brand mark, as a file:// URL for QtQuick.Image. Vendored per
# theme dir (see themes/CLAUDE.md), so a theme without one simply falls back to
# its glyph rather than needing a special case here.
theme_icon() {
    icon="$THEMES_DIR/$1/icon.png"
    [ -f "$icon" ] && printf 'file://%s' "$icon"
}

# One tab-separated row per theme: variant, glyph, display name, slug, badge,
# icon URL.
theme_rows() {
    for theme_dir in "$THEMES_DIR"/*; do
        [ -d "$theme_dir" ] || continue
        theme=$(basename "$theme_dir")
        [ "$theme" = "current" ] && continue

        badge=""
        [ "$theme" = "$CURRENT_THEME" ] && badge="current"

        printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$("$THEME_SWITCHER" variant "$theme")" \
            "$(theme_glyph "$theme")" \
            "$(echo "$theme" | sed 's/-/ /g' | sed 's/\b\(.\)/\u\1/g')" \
            "$theme" \
            "$badge" \
            "$(theme_icon "$theme")"
    done | sort -t"$TAB" -k3,3
}

# The rows grouped under a section label, dark first. A variant with no themes
# contributes nothing, so a trimmed-down themes directory cannot leave an empty
# heading behind.
build_items() {
    rows=$(theme_rows)

    for variant in dark light other; do
        group=$(printf '%s\n' "$rows" | awk -F'\t' -v v="$variant" '$1 == v')
        [ -n "$group" ] || continue

        printf 'header\t\t%s\t\t\t\n' "$(printf '%s' "$variant" | tr '[:lower:]' '[:upper:]')"
        printf '%s\n' "$group"
    done | jaq -R -s -c '
        [ split("\n")[]
          | select(length > 0)
          | split("\t")
          | if .[0] == "header"
            then {header: true, title: .[2]}
            else {glyph: .[1], title: .[2], payload: .[3], badge: .[4], iconSource: .[5]}
            end ]'
}

ITEMS=$(build_items)

if [ "$1" = "--print-items" ]; then
    printf '%s\n' "$ITEMS"
    exit 0
fi

# This one does not source menu-helpers.sh: show_menu() is the plain-string
# path, and these rows are objects.
SELECTED=$(printf '%s' "$ITEMS" |
    "$SCRIPTS_DIR/desktop/quickshell-menu" --json --prompt "Select Theme")

# Switch to selected theme — the answer is the payload, so it is already a slug.
if [ -n "$SELECTED" ]; then
    "$THEME_SWITCHER" switch "$SELECTED"
fi
