#!/usr/bin/env sh

# Script: voxtype-record
# Purpose: Wrapper around `voxtype record` for Hyprland keybindings. Restarts
#          the daemon transparently if voxtype-idle-unload.timer stopped it,
#          waiting for its socket before forwarding the record command.
# Requirements: voxtype, systemctl --user

SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/voxtype/audio.sock"

if ! systemctl --user is-active --quiet voxtype.service; then
    systemctl --user start voxtype.service

    i=0
    while [ "$i" -lt 50 ]; do
        [ -S "$SOCK" ] && break
        sleep 0.1
        i=$((i + 1))
    done
fi

exec voxtype record "$@"
