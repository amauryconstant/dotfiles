#!/usr/bin/env sh

# Script: waybar-style.sh
# Purpose: Configure Waybar styling
# Requirements: Arch Linux, quickshell-menu

# Waybar style configuration menu
if [ -x "$HOME/.local/lib/scripts/desktop/quickshell-menu" ]; then
    STYLE=$(echo "󰍹 Default\n󰖩 Dark\n󰔜 Light\n󰥔 Minimal\n󰔓 Compact" | "$HOME/.local/lib/scripts/desktop/quickshell-menu" --prompt "Waybar Style")
    
    case "$STYLE" in
        "󰍹 Default")
            # Reload default style
            killall -SIGUSR2 waybar
            notify-send "󰘯 Waybar" "Applied default style"
            ;;
        "󰖩 Dark")
            # Apply dark theme (placeholder)
            killall -SIGUSR2 waybar
            notify-send "󰘯 Waybar" "Applied dark style"
            ;;
        "󰔜 Light")
            # Apply light theme (placeholder)
            killall -SIGUSR2 waybar
            notify-send "󰘯 Waybar" "Applied light style"
            ;;
        "󰥔 Minimal")
            # Apply minimal theme (placeholder)
            killall -SIGUSR2 waybar
            notify-send "󰘯 Waybar" "Applied minimal style"
            ;;
        "󰔓 Compact")
            # Apply compact theme (placeholder)
            killall -SIGUSR2 waybar
            notify-send "󰘯 Waybar" "Applied compact style"
            ;;
    esac
else
    notify-send "󰘯 Waybar" "no menu picker available for style configuration"
fi