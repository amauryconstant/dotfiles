#!/usr/bin/env sh

# Script: immediate-lock
# Purpose: Lock the screen immediately (single entry point for all lock triggers)
# Requirements: Arch Linux, quickshell (the running shell), flock (util-linux), hyprctl
#
# Used by Super+L, the system menu, and hypridle's lock_cmd.
#
# ONE route: the Quickshell lock surface (§22), asked over IPC. hyprlock was the
# runtime fallback until 2026-10-19 and is gone, so a shell that is down, hung,
# out of restart budget or running a broken QML tree means the screen is NOT
# locked -- and this script says so with a critical-looking notice and exits 1.
# 🚨 That includes lock-before-suspend: hypridle holds the sleep inhibitor only
# until logind's InhibitDelayMaxSec (5 s), after which a machine whose shell is
# dead sleeps UNLOCKED. Recovery from a TTY: desktop/CLAUDE.md -> Idle & Lock.
#
# 🚨 The notice goes through `hyprctl notify`, never notify-send: this shell IS
# the notification daemon, so notify-send reaches nothing in exactly the case
# this script reports. Same channel as the uwsm warning in hypr/conf/autostart.
#
# 🚨 `quickshell ipc call` exits 0 EVEN WHEN IT FAILS: a target that does not
# exist prints "Target not found." and still returns 0. So success is decided
# by the ANSWER, never the exit status -- the same rule quickshell-toggle's
# shell_running() follows.
#
# 🚨 The re-entrancy guard is a LOCK FILE. Since hypr/conf/general sets
# misc:allow_session_lock_restore, the compositor accepts a second locker where
# it used to refuse one, so a check-then-act guard that loses its race can
# displace a live lock screen out from under whoever is typing into it. flock
# serialises concurrent calls (Super+L racing hypridle); the shell's own lock
# state is the guard from there on, and a second call just gets "ok" back.
# desktop/session-lock-stranded reads the same file.
#
# An ext-session-lock outlives its client, so a killed shell leaves the session
# behind Hyprland's failsafe. The new shell re-acquires the lock on start
# (LockScreen.checkStranded); ask `desktop/session-locked` whether that is the
# situation. It is not consulted here because the action is the same either way.

LOCKFILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/immediate-lock.lock"

exec 9>"$LOCKFILE" || exit 1
flock -n 9 || exit 0

# 🚨 Bounded: a shell that is alive but hung never answers, and without the
# timeout this blocked forever while holding the flock, every later lock attempt
# exiting 0 on the held lock. 1 s, not more: a healthy answer takes ~35 ms. If
# the shell later resumes it still runs the queued call.
ANSWER=$(timeout 1 quickshell -c dotfiles ipc call lock lock 2>/dev/null)
if [ "$ANSWER" = ok ]; then
    exit 0
fi

# "No running instances for ..." arrives on STDOUT, with a dead-instance list.
case "$ANSWER" in
"" | "No running instances"*) REASON="the shell is not running or not answering" ;;
missing-pam) REASON="/etc/pam.d/login is missing" ;;
disabled) REASON="the lock is switched off in the shell" ;;
*) REASON="the shell answered '$(printf '%s' "$ANSWER" | head -n 1)'" ;;
esac
echo "immediate-lock: screen NOT locked: $REASON" >&2
# 10 s, icon 3 (error), red.
hyprctl notify 3 10000 "rgb(ff4444)" "Screen NOT locked: $REASON" >/dev/null 2>&1 || true
exit 1
