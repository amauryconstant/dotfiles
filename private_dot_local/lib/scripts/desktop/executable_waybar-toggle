#!/usr/bin/env sh

# Script: waybar-toggle.sh
# Purpose: Toggle waybar visibility for distraction-free mode
# Requirements: Arch Linux, waybar, pkill
# Adapted from: Omarchy's omarchy-toggle-waybar

# Wait for waybar to disappear after a kill (up to ~2s).
wait_for_waybar_stopped() {
    _tries=20 # 20 x 0.1s
    while [ "$_tries" -gt 0 ]; do
        pgrep -x waybar >/dev/null || return 0
        sleep 0.1
        _tries=$((_tries - 1))
    done
    return 1
}

if pgrep -x waybar >/dev/null; then
    # Waybar is running -> Kill it (hide).
    # -9 is required: current waybar does not exit on SIGTERM here, so a plain
    # pkill leaves a stale process and the *next* toggle never restarts the bar.
    pkill -9 -x waybar

    if wait_for_waybar_stopped; then
        notify-send "📊 Waybar" "Status bar hidden" -t 2000
    else
        notify-send "📊 Waybar" "Failed to hide status bar" -t 2000
    fi
else
    # Waybar not running -> Start it (show)
    waybar &

    # Let it settle, then report the state actually reached rather than intended
    sleep 0.5
    if pgrep -x waybar >/dev/null; then
        notify-send "📊 Waybar" "Status bar shown" -t 2000
    else
        notify-send "📊 Waybar" "Failed to start status bar" -t 2000
    fi
fi
