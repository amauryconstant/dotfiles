#!/usr/bin/env sh

# Script: nightlight-toggle
# Purpose: Toggle blue light filter using hyprsunset
# Requirements: Arch Linux, hyprsunset, hyprctl
# Bound to: Super+N / menu-trigger Toggle submenu
# Adapted from: Omarchy's omarchy-toggle-nightlight
#
# Drives the running daemon over IPC instead of killing and respawning it on
# every toggle. Three measured properties of `hyprctl hyprsunset` shape this:
#   - it always exits 0, even for "invalid command", so the *output* has to be
#     checked ("ok") or the value read back — exit status proves nothing
#   - a bare `temperature` reads the current value back (undocumented)
#   - `identity` does NOT reset that read-back, so temperature alone cannot
#     distinguish "filter on" from "identity active" — hence the marker
#
# The marker lives in $XDG_RUNTIME_DIR (tmpfs) because hyprsunset does not
# survive a logout either; a persistent marker would claim "on" with no daemon.

TEMP_FILE="$HOME/.local/state/dotfiles/nightlight-temp"
MARKER="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/nightlight-on"
DEFAULT_TEMP=4000

# Warm temperature chosen via nightlight-config, falling back to the default.
# Rejects anything hyprsunset would refuse, so a corrupt file cannot wedge us.
warm_temp() {
    if [ -f "$TEMP_FILE" ]; then
        read -r _t < "$TEMP_FILE" 2>/dev/null
        case "$_t" in
            '' | *[!0-9]*) ;;
            *)
                if [ "$_t" -ge 1000 ] && [ "$_t" -le 20000 ]; then
                    echo "$_t"
                    return
                fi
                ;;
        esac
    fi
    echo "$DEFAULT_TEMP"
}

# Wait for the daemon's IPC socket to answer (up to ~3s)
wait_for_hyprsunset() {
    _tries=15 # 15 x 0.2s
    while [ "$_tries" -gt 0 ]; do
        hyprctl hyprsunset temperature >/dev/null 2>&1 && return 0
        sleep 0.2
        _tries=$((_tries - 1))
    done
    return 1
}

WARM=$(warm_temp)

# No daemon means no filter, whatever a stale marker claims -> start warm
if ! pgrep -x hyprsunset >/dev/null; then
    rm -f "$MARKER"
    setsid hyprsunset -t "$WARM" >/dev/null 2>&1 &

    if wait_for_hyprsunset && [ "$(hyprctl hyprsunset temperature 2>/dev/null)" = "$WARM" ]; then
        : >"$MARKER"
        notify-send "🌙 Nightlight" "Blue light filter enabled (${WARM}K)" -t 2000
    else
        notify-send "🌙 Nightlight" "Failed to start blue light filter" -t 2000
    fi
    exit 0
fi

if [ -f "$MARKER" ]; then
    # Currently warm -> identity (no colour transform at all)
    if [ "$(hyprctl hyprsunset identity 2>/dev/null)" = "ok" ]; then
        rm -f "$MARKER"
        notify-send "🌞 Nightlight" "Blue light filter disabled" -t 2000
    else
        notify-send "🌞 Nightlight" "Failed to disable blue light filter" -t 2000
    fi
else
    hyprctl hyprsunset temperature "$WARM" >/dev/null 2>&1

    if [ "$(hyprctl hyprsunset temperature 2>/dev/null)" = "$WARM" ]; then
        : >"$MARKER"
        notify-send "🌙 Nightlight" "Blue light filter enabled (${WARM}K)" -t 2000
    else
        notify-send "🌙 Nightlight" "Failed to enable blue light filter" -t 2000
    fi
fi
