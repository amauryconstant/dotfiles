#!/usr/bin/env sh

# Script: lock-before-sleep
# Purpose: Lock the session and WAIT for the compositor to confirm it, before
#          suspend is allowed to proceed
# Requirements: Arch Linux, loginctl, hyprctl, jaq
# Usage: hypridle's before_sleep_cmd (.chezmoitemplates/hypridle_general)
#
# 🚨 `loginctl lock-session` is ASYNCHRONOUS. It emits the Lock signal and
# returns; hypridle then runs lock_cmd, which spawns the locker and returns too.
# Used directly as before_sleep_cmd, hypridle's "before_sleep handling is done"
# is therefore true while nothing is drawn yet -- it releases the delay
# inhibitor, the machine suspends, and the lock surface may only exist after the
# resume. One frame of desktop is the whole failure.
#
# hypridle ALREADY holds the inhibitor ("Hypridle wants to delay sleep until
# it's before_sleep handling is done", visible in `systemd-inhibit --list`), so
# nothing here needs to take one -- Omarchy's separate omarchy-sleep-lock.service
# exists because its shell has no hypridle to borrow. All that is missing is for
# this command to stay in the foreground until the lock is real.
#
# The wait asks the COMPOSITOR, not the locker, so it is route-agnostic: it is
# the same answer whether the Quickshell lock surface or hyprlock got there.
#
# ⚠️ Budget is bounded well under logind's InhibitDelayMaxUSec (5s here,
# `busctl get-property org.freedesktop.login1 /org/freedesktop/login1
# org.freedesktop.login1.Manager InhibitDelayMaxUSec`). Past it logind suspends
# regardless, so a script that waited longer would only make the lock later, not
# surer -- and blocking forever would stop the machine suspending at all.

SESSION_LOCKED="$(dirname -- "$0")/session-locked"

loginctl lock-session

# 40 x 0.1s = 4s, inside the 5s delay budget.
tries=40
while [ "$tries" -gt 0 ]; do
    # 0 locked. 1 unlocked, 2 undetermined -- neither is an answer to wait on,
    # and 2 in particular must not be read as "no", so both just retry.
    if "$SESSION_LOCKED"; then
        exit 0
    fi
    sleep 0.1
    tries=$((tries - 1))
done

# Timed out. Suspend anyway: logind is about to force it, and holding the
# inhibitor to its cap would leave the machine awake with the lid shut.
echo "lock-before-sleep: no lock confirmed in 4s, suspending anyway" >&2
exit 0
