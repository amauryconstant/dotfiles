#!/usr/bin/env sh

# Script: quickshell-toggle
# Purpose: Toggle a Quickshell surface, starting the shell if it is not running
# Requirements: Arch Linux, quickshell
# Usage: quickshell-toggle [bar|launcher|power|notifications|overview|clipboard|keybindings]
#        quickshell-toggle popover <audio|network|bluetooth|calendar|media|meters|power|nightlight>
#        (default: bar)
# Bound to: SUPER+B (bar), SUPER+D (launcher), SUPER+SHIFT+Q (power menu),
#           SUPER+grave (overview)
#           — hypr/conf.d/quickshell.{lua,conf}; SUPER+SHIFT+N (notifications)
#           — hypr/conf/bindings/system-control.{lua,conf}.tmpl, which is where
#           it lives because that key is gated on a different feature flag
#
# Mirrors waybar-toggle, with one difference: a running Quickshell hides and
# shows over IPC rather than being killed and relaunched. That is instant and
# keeps the shell's state, so only a missing instance needs a launch.
#
# One script for every surface because the hard part is identical for all of
# them: IPC only reaches a RUNNING instance, so every binding needs the same
# launch-then-retry dance.

CONFIG=dotfiles
TARGET=${1:-bar}
# Only the popover target takes one, and it is which popover: the IPC handler
# is `popover toggle <id>` rather than eight separate targets, because they are
# one surface with eight payloads.
ARG=${2:-}

case "$TARGET" in
bar | launcher | power | notifications | overview | clipboard | keybindings) ;;
popover)
    case "$ARG" in
    audio | network | bluetooth | calendar | media | meters | power | nightlight) ;;
    *)
        echo "quickshell-toggle: popover needs an id (audio|network|bluetooth|calendar|media|meters|power|nightlight)" >&2
        exit 2
        ;;
    esac
    ;;
*)
    echo "quickshell-toggle: unknown target '$TARGET' (bar|launcher|power|notifications|overview|clipboard|keybindings|popover <id>)" >&2
    exit 2
    ;;
esac

# ⚠️ `quickshell ipc` exits 0 even when it fails — with no instance it prints
# "No running instances for ..." and still returns 0. So liveness has to be
# read from the output, never the exit status.
#
# ⚠️ Addressed by config name rather than `pgrep -x quickshell`: voxtype runs
# its own Quickshell instance, and a bare process match would find that one.
shell_running() {
    quickshell -c "$CONFIG" ipc show 2>/dev/null | grep -q "^target $TARGET\$"
}

# Every target's toggle() returns the state it actually reached, so a failure
# is visible here rather than being assumed from an exit code that is always 0.
toggle_target() {
    state=$(quickshell -c "$CONFIG" ipc call "$TARGET" toggle ${ARG:+"$ARG"} 2>/dev/null)
    case "$state" in
    shown | hidden)
        # Only the bar reports success: it can be toggled off-screen, so what
        # happened is not otherwise observable. A launcher or a power menu
        # appearing in front of you is its own notification.
        if [ "$TARGET" = bar ]; then
            notify-send "󰕮 Quickshell" "Bar $state" -t 2000
        fi
        return 0
        ;;
    *)
        # Also to stderr: once swaync is masked, THIS SHELL is the notification
    # daemon, so a notify-send about it being down has nothing to reach.
    echo "quickshell-toggle: $TARGET not responding" >&2
        notify-send "󰕮 Quickshell" "$TARGET not responding" -t 2000
        return 1
        ;;
    esac
}

if shell_running; then
    toggle_target
    exit $?
fi

# The surfaces that had a tool before the shell replaced them fall back to it
# when the shell cannot be reached: the flag is off (no shell.qml deployed), or
# the unit will not come up. Without this, SUPER+D and the system menu's Apps /
# Clipboard History entries were dead whenever the shell was. Overview and the
# popovers never had a predecessor, so they only report the failure.
fallback() {
    case "$TARGET" in
    launcher) exec wofi --show drun ;;
    clipboard)
        # main's menu-trigger pipeline, verbatim
        cliphist list | wofi --dmenu | cliphist decode | wl-copy
        exit $?
        ;;
    power) exec wlogout ;;
    keybindings) exec "$HOME/.local/lib/scripts/desktop/keybindings" ;;
    notifications)
        # Only while swaync is actually the daemon; masked, it would activate nothing.
        if [ "$(systemctl --user is-enabled swaync.service 2>/dev/null)" != masked ]; then
            exec swaync-client -t -sw
        fi
        ;;
    *) ;;
    esac
    return 1
}

# No deployed tree: the Waybar branch. Starting the unit would only fail its
# ConditionPathExists, so skip straight to the predecessor tool.
if [ ! -f "$HOME/.config/quickshell/$CONFIG/shell.qml" ]; then
    fallback
    echo "quickshell-toggle: shell not deployed (features.quickshell_shell off)" >&2
    exit 1
fi

# Through systemd, never a bare launch: a shell started any other way is
# unsupervised, which is the whole point of quickshell.service.
#
# reset-failed first. Once the unit exhausts StartLimitBurst (5 restarts in
# 60s) systemd refuses `start` until the failure is cleared -- and at that
# moment there is no bar, no launcher and no notification daemon left, so this
# keybinding is the only route back.
systemctl --user reset-failed quickshell.service 2>/dev/null || true
systemctl --user start quickshell.service

# Report the state actually reached. Polling rather than a flat sleep: startup
# is usually well under a second, but a cold theme read can push it out.
_tries=20 # 20 x 0.1s
while [ "$_tries" -gt 0 ]; do
    if shell_running; then
        if [ "$TARGET" = bar ]; then
            notify-send "󰕮 Quickshell" "Bar started" -t 2000
            exit 0
        fi
        # A cold start deliberately still opens the surface that was asked for:
        # the keypress meant "show me this", not "start the shell".
        toggle_target
        exit $?
    fi
    sleep 0.1
    _tries=$((_tries - 1))
done

echo "quickshell-toggle: failed to start shell" >&2
notify-send "󰕮 Quickshell" "Failed to start shell" -t 2000
fallback
exit 1
