#!/usr/bin/env sh

# Script: idle-toggle.sh
# Purpose: Toggle automatic screen locking (presentation mode)
# Requirements: Arch Linux, hypridle
# Adapted from: Omarchy's omarchy-toggle-idle

NOLOCK_CONF="$HOME/.config/hypr/hypridle-nolock.conf"

if pgrep -af hypridle | grep -q -- "-c $NOLOCK_CONF"; then
    # Currently in no-lock mode -> switch to full lock protection
    pkill -x hypridle
    hypridle &
    notify-send "▶️ Idle Lock" "Auto-lock enabled" -t 2000
elif pgrep -x hypridle >/dev/null; then
    # Full lock protection running -> Kill it (disable auto-lock)
    pkill -x hypridle
    notify-send "⏸️ Idle Lock" "Auto-lock disabled (presentation mode)" -t 2000
else
    # hypridle not running -> Start it (enable auto-lock)
    hypridle &
    notify-send "▶️ Idle Lock" "Auto-lock enabled" -t 2000
fi

# Refresh Waybar idle indicator
pkill -RTMIN+9 waybar 2>/dev/null || true
