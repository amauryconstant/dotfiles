#!/usr/bin/env sh

# Script: quickshell-menu
# Purpose: Present a list and print the chosen item — the dmenu contract, served
#          by the Quickshell shell (it replaced Wofi, retired 2026-10-19)
# Requirements: Arch Linux, jaq, openbsd-netcat, hyprctl
# Usage: printf 'a\nb\n' | quickshell-menu [--prompt "Title"]
#            [--breadcrumb "Setup"] [--back "󰁍 Back"]
#        printf '[{"title":"Dawn","payload":"rose-pine-dawn"}]' |
#            quickshell-menu --json [--prompt "Title"]
# Exit:  0 with the chosen line on stdout; 1 and no output when cancelled OR
#        when the shell cannot be reached (with a `hyprctl notify` saying so) —
#        every caller tests for empty, as it did for `wofi --dmenu`
#
# Reads items on stdin, newline-separated, exactly as `wofi --dmenu` did.
#
# --json takes a JSON ARRAY on stdin instead, one object per row, and answers
# with the chosen row's `payload` rather than its visible text:
#
#   {"title": "Rose Pine Dawn", "glyph": "", "badge": "current",
#    "payload": "rose-pine-dawn"}   a row; payload defaults to the title
#   {"header": true, "title": "LIGHT"}   a section label, never selectable
#
# That is how a caller gets a glyph column and a state marker without packing
# them into the label — see theme-menu, and quickshell/dotfiles/MenuServer.qml
# for the shape it normalises into.
#
# --breadcrumb and --back are design page 10's navigation model, and they move
# only the NAVIGATION into the shell: the tree stays in the menu-* scripts.
# --breadcrumb draws before the prompt ("Setup › Displays"); --back is answered
# on Left or Backspace with an empty query, so a submenu no longer needs to
# spend a row on 󰁍 Back — though the rows stay, because the value is a payload
# the script dispatches through the arm it already has.
#
# The 󰁍 Back rows stay even though the shell now answers the gesture: the value
# is a payload the script dispatches through the arm it already has.
#
# 🚨 There is NO fallback picker (Wofi was it until 2026-10-19). These menus can
# run during first-boot setup and while the shell is being restarted; with the
# shell down they CANCEL, with a notice, instead of hanging. `hyprctl notify`,
# not notify-send: the shell is the notification daemon, so a notify-send about
# it being down has nothing to reach.
#
# Why a socket and not `quickshell ipc call`: an IPC handler returns
# immediately, and `ipc call` exits 0 even for a target that does not exist. A
# menu has to BLOCK until the user chooses. See quickshell/dotfiles/MenuServer.qml.

PROMPT=""
JSON_MODE=0
# Optional navigation. A caller that omits both gets the surface it always got.
BREADCRUMB=""
BACK=""

while [ $# -gt 0 ]; do
    case "$1" in
    --prompt)
        PROMPT="$2"
        shift 2
        ;;
    --prompt=*)
        PROMPT="${1#--prompt=}"
        shift
        ;;
    --json)
        JSON_MODE=1
        shift
        ;;
    --breadcrumb)
        BREADCRUMB="$2"
        shift 2
        ;;
    --breadcrumb=*)
        BREADCRUMB="${1#--breadcrumb=}"
        shift
        ;;
    --back)
        BACK="$2"
        shift 2
        ;;
    --back=*)
        BACK="${1#--back=}"
        shift
        ;;
    *)
        shift
        ;;
    esac
done

SOCKET="${XDG_RUNTIME_DIR}/quickshell-menu.sock"
ITEMS=$(cat)

if [ "$JSON_MODE" -eq 1 ]; then
    # A malformed array is a caller bug, not a cancellation, so it says so on
    # stderr rather than looking like the user pressed Esc.
    if ! REQUEST=$(printf '%s' "$ITEMS" |
        jaq -c --arg p "$PROMPT" --arg c "$BREADCRUMB" --arg b "$BACK" \
            '{prompt:$p, breadcrumb:$c, back:$b, items:.}' 2>/dev/null); then
        echo "quickshell-menu: --json expects a JSON array on stdin" >&2
        exit 1
    fi
else
    REQUEST=$(printf '%s\n' "$ITEMS" |
        jaq -R -s -c --arg p "$PROMPT" --arg c "$BREADCRUMB" --arg b "$BACK" \
            '{prompt:$p, breadcrumb:$c, back:$b, items:(rtrimstr("\n") | split("\n"))}')
fi

# 🚨 The reachability test is the CONNECTION, never `[ -S "$SOCKET" ]`. A shell
# that is killed leaves its socket file behind — quickshell deletes a stale one
# only when it next starts (socket.cpp:170) — so the file test passes against a
# dead shell, nc then fails, and the caller gets an empty answer it reads as a
# cancellation. That is precisely the hang the fallback exists to prevent, so it
# has to hinge on nc's exit status instead.
#
# 🚨 NOT `nc -N`. That half-closes the write side after the request, and
# QLocalSocket has no half-close: Qt reports PeerClosedError and drops the
# connection before the shell can answer, so every call came back empty. Plain
# `nc -U` holds the socket open and exits when the shell closes it, which is
# exactly the handshake MenuServer.respond() performs.
# 🚨 The trailing newline is REQUIRED and is not there for tidiness: the shell
# reads the request through a SplitParser, which emits nothing until it sees
# one, and `$(...)` has already stripped the newline jaq wrote. Without it the
# request is never parsed, the shell never answers, and nc waits forever —
# there is no timeout anywhere in this path.
#
# 🚨 Nor can there be one on nc: it legitimately waits for as long as the user
# takes to choose. A shell that is alive but HUNG would accept the connection
# and never answer, so liveness is probed first through the IPC socket, which
# answers in ~35 ms (measured 2026-10-06) when the event loop runs. Only a
# timeout (124) counts as hung; "No running instances" returns at once, and nc
# then fails to connect.
shell_responsive() {
    timeout 1 quickshell -c dotfiles ipc show >/dev/null 2>&1
    [ $? -ne 124 ]
}

if shell_responsive && RESULT=$(printf '%s\n' "$REQUEST" | nc -U "$SOCKET" 2>/dev/null); then
    [ -n "$RESULT" ] || exit 1
    printf '%s\n' "$RESULT"
    exit 0
fi

# Only two ways here: the shell is hung (the probe timed out) or nc could not
# connect (no shell, a stale socket file). A BUSY picker is not one of them: it
# accepts and closes, so nc exits 0 with an empty answer, handled above.
# Cancelled, not hung: the caller reads empty as Esc.
MSG="Menu unavailable: the shell is not running or not answering"
echo "quickshell-menu: $MSG" >&2
hyprctl notify 3 5000 "rgb(ff4444)" "$MSG" >/dev/null 2>&1 || true
exit 1
