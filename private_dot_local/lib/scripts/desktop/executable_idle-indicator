#!/usr/bin/env sh

# Script: idle-indicator
# Purpose: Waybar custom module showing idle-lock disabled state
# Returns: JSON for Waybar (only visible when idle-lock is OFF)

NOLOCK_CONF="$HOME/.config/hypr/hypridle-nolock.conf"

if pgrep -af hypridle | grep -q -- "-c $NOLOCK_CONF"; then
    # hypridle running with no-lock config = display still powers off, lock disabled
    echo '{"text": "󰍹", "tooltip": "Idle lock disabled (display still powers off)", "class": "nolock"}'
elif pgrep -x hypridle >/dev/null; then
    # hypridle running with default config = idle-lock fully enabled = nothing to show
    echo '{"text": ""}'
else
    # hypridle not running = idle-lock disabled = show indicator
    echo '{"text": "󱫖", "tooltip": "Idle lock disabled", "class": "active"}'
fi
