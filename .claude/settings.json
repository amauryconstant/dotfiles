    "deny": [
      "Bash(chezmoi apply)",
      "Bash(chezmoi apply :*)",
      "Bash(chezmoi add --encrypt:*)",
      "Bash(chezmoi decrypt:*)",
      "Bash(chezmoi edit:*)",
      "Bash(rm -rf:*)",
