      "Bash(jq:*)",
      "Bash(mise run:*)",
      "Bash(mise tasks:*)",
      "Bash(journalctl:*)",
      "Bash(hyprctl clients:*)",
      "Bash(hyprctl monitors:*)",
      "Bash(hyprctl layers:*)",
      "Bash(hyprctl workspaces:*)",
      "Bash(hyprctl activewindow:*)",
      "Bash(hyprctl getoption:*)",
      "Bash(hyprctl version:*)",
      "Bash(hyprctl -j:*)",
      "Bash(systemctl status:*)",
