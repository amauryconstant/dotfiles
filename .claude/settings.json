      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git branch -D:*)",
      "Bash(sudo:*)",
      "Bash(pacman -S:*)",
      "Bash(pacman -R:*)",
      "Bash(paru -S:*)",
      "Bash(paru -R:*)",
      "Bash(systemctl --user enable:*)",
      "Bash(systemctl --user disable:*)",
      "Bash(systemctl --user stop:*)",
      "Bash(systemctl --user restart:*)",
      "Bash(mkinitcpio:*)",
      "Bash(hyprpm:*)",
      "Bash(rage:*)",
      "Bash(age:*)"
    ]
  },
  "env": {
    "PONYTAIL_DEFAULT_MODE": "full",
    "PONYTAIL_SUBAGENT_MATCHER": "^(?!.*(investigator|reviewer|researcher|explore|guide|statusline|plan-updater))"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty' 2>/dev/null); [[ -n \"$f\" && ( \"$f\" =~ private_dot_keys || \"$f\" =~ \\.age$ ) ]] && { echo \"Blocked: encrypted path — use chezmoi add --encrypt or chezmoi edit instead\" >&2; exit 2; } || exit 0",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-chezmoi-cat.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty' 2>/dev/null); [[ \"$f\" =~ \\.sh$ && ! \"$f\" =~ \\.tmpl$ ]] || exit 0; out=$( { bash -n \"$f\" && shellcheck --severity=warning \"$f\"; } 2>&1 ) || { echo \"$out\" >&2; exit 2; }",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty' 2>/dev/null); [[ \"$f\" =~ \\.sh\\.tmpl$ ]] || exit 0; tmp=$(mktemp --suffix=.sh); out=$(chezmoi execute-template < \"$f\" 2>&1 > \"$tmp\") && out=$(shellcheck --severity=warning \"$tmp\" 2>&1); rc=$?; rm -f \"$tmp\"; [[ $rc -eq 0 ]] || { echo \"$out\" >&2; exit 2; }",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty' 2>/dev/null); [[ \"$f\" =~ \\.tmpl$ && ! \"$f\" =~ \\.sh\\.tmpl$ && ! \"$f\" =~ /modify_ && ! \"$f\" =~ \\.chezmoitemplates ]] || exit 0; out=$(chezmoi execute-template < \"$f\" 2>&1 >/dev/null) || { echo \"$out\" | head -5 >&2; exit 2; }",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty' 2>/dev/null); [[ \"$f\" =~ \\.chezmoidata/.*\\.yaml$ ]] || exit 0; out=$(mise run lint:yaml-file -- \"$f\" 2>&1) || { echo \"$out\" >&2; exit 2; }",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty' 2>/dev/null); [[ \"$f\" =~ private_dot_config/(hypr|themes|hyprdynamicmonitors|dotfiles)/.*\\.lua$ ]] || exit 0; out=$(mise run lint:lua-file -- \"$f\" 2>&1) || { echo \"$out\" >&2; exit 2; }",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty' 2>/dev/null); [[ \"$f\" =~ \\.(json|jsonc)$ && ! \"$f\" =~ /modify_ ]] || exit 0; out=$(mise run lint:json-file -- \"$f\" 2>&1) || { echo \"$out\" >&2; exit 2; }",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty' 2>/dev/null); [[ \"$f\" =~ private_dot_config/quickshell/.*\\.qml(\\.tmpl)?$ ]] || exit 0; out=$( { [[ \"$f\" == *.tmpl ]] || { /usr/lib/qt6/bin/qmlformat \"$f\" | diff -u \"$f\" - | head -20; }; \"$CLAUDE_PROJECT_DIR\"/.mise/tasks/lint/qml-rules.sh \"$f\" 2>&1; } 2>&1 ); [[ -z \"$out\" ]] || { echo \"$out\" >&2; exit 2; }",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "remember@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  }
}
