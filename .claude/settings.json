      "Bash(systemctl --user show:*)",
      "Bash(systemctl --user cat:*)",
      "Bash(loginctl:*)",
      "Bash(paru -Q:*)",
      "Bash(paru -Si:*)",
      "Bash(paru -Ss:*)",
      "Bash(pacman -Q:*)",
      "Bash(pacman -Qdt:*)",
      "Bash(pacman -Si:*)",
      "Bash(pacman -Ss:*)",
      "Bash(flatpak list:*)",
      "Bash(flatpak info:*)",
      "Bash(bat:*)",
      "Bash(fd:*)",
      "Bash(rg:*)",
      "Bash(fzf:*)",
      "Bash(swww query:*)",
      "Bash(darkman get:*)",
      "Bash(yamllint:*)",
      "Bash(stylua:*)",
      "Bash(lua-language-server:*)",
      "mcp__plugin_context7_context7__resolve-library-id",
