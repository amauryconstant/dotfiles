# Targets whose source was deleted. chezmoi never removes a target just because
# its source is gone, so without this they linger on every machine provisioned
# before the deletion. Entries are harmless once spent (absent paths are no-ops)
# and stay as a record. Flag-gated drop-ins are NOT listed here: chezmoi skips
# remove entries that are ignored, so run_onchange_after_configure_desktop_shell
# handles those.

# Voxtype recording submap — replaced by the bar indicator (quickshell branch).
# Still loaded by the conf.d glob and still defining binds where it survives.
.config/hypr/conf.d/voxtype-submap.lua
.config/hypr/conf.d/voxtype-submap.conf

# dunst theme files — dunst retired for swaync, then Quickshell.
.config/themes/*/dunst.conf

# Wofi keybindings sheet style — the sheet is a Quickshell surface now.
.config/wofi/keybinds.css

# hyprwhenthen — its only handler (OAuth popup float) is hypr/conf/oauth-popups.lua now.
# Stopping the running unit is manual: systemctl --user disable --now hyprwhenthen.service
.config/hyprwhenthen
.config/systemd/user/hyprwhenthen.service

# wlogout — the power menu is a Quickshell surface.
.config/wlogout
.config/themes/*/wlogout.css
.local/lib/scripts/desktop/wlogout

# swaync — notifications are the Quickshell shell's. The unit stays masked on machines
# that had it; `systemctl --user unmask swaync.service` after removing the package.
.config/swaync
.config/themes/*/swaync.css

# polkit-gnome autostart drop-in — the Quickshell shell owns the polkit agent.
# A stale copy would start a second agent, so this must go with the package.
.config/hypr/conf.d/polkit-gnome.lua
.config/hypr/conf.d/polkit-gnome.conf

# Waybar — retired; the Quickshell bar is the only bar. The conf.d drop-in must go
# or Hyprland's conf.d glob would start Waybar beside the shell and claim a second
# SUPER+B. Stopping the running process is manual: pkill waybar.
.config/waybar
.config/themes/*/waybar.css
.config/hypr/conf.d/waybar.lua
.config/hypr/conf.d/waybar.conf
.local/lib/scripts/desktop/waybar-toggle
.local/lib/scripts/desktop/waybar-style

# hyprlock — retired 2026-10-19; the Quickshell lock is the only locker and desktop/immediate-lock
# has no fallback. Remove the package by hand: paru -Rns hyprlock
.config/hypr/hyprlock.conf
.config/themes/*/hyprlock.conf

# Wofi — retired 2026-10-19; the Quickshell launcher/pickers have no fallback. Remove the
# package by hand: paru -Rns wofi (its usage cache ~/.cache/wofi-drun is seeded once into the
# launcher's own state file, then unused).
.config/wofi
.config/themes/*/wofi.css

# package-manager shrank to sync/update/approve (lib/ + dispatcher); the old module trees are gone.
.local/lib/scripts/system/package-manager/core
.local/lib/scripts/system/package-manager/operations
.local/lib/scripts/system/package-manager/packages
.local/lib/scripts/system/package-manager/commands

# Super+Space menu tree — retired 2026-10-23; the launcher's `>` mode (user-interface/launcher-actions)
# replaced system-menu and its menu-* wrappers.
.local/lib/scripts/user-interface/system-menu
.local/lib/scripts/user-interface/utilities-menu
.local/lib/scripts/user-interface/menu-about
.local/lib/scripts/user-interface/menu-ai
.local/lib/scripts/user-interface/menu-install
.local/lib/scripts/user-interface/menu-learn
.local/lib/scripts/user-interface/menu-remove
.local/lib/scripts/user-interface/menu-setup
.local/lib/scripts/user-interface/menu-style
.local/lib/scripts/user-interface/menu-system
.local/lib/scripts/user-interface/menu-trigger
.local/lib/scripts/user-interface/menu-update

# Firefox follows its own per-profile native themes now, not the desktop theme.
.local/lib/scripts/desktop/theme-apply-firefox
.config/themes/*/firefox-userChrome.css
