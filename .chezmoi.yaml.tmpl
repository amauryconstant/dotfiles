{{ $fullname := promptStringOnce . "fullname" "What is your full name? " -}}
{{ $workEmail := promptStringOnce . "workEmail" "What is your work email address? " -}}
{{ $personalEmail := promptStringOnce . "personalEmail" "What is your personal email address? " -}}
{{ $privateServer := promptStringOnce . "privateServer" "What is the URL of your private server? " -}}
{{ $ovhKS5ServerIP := promptStringOnce . "ovhKS5ServerIP" "What is the IP v4 of your OVH Bare Metal server? " -}}
{{ $ovhVPSServerIP := promptStringOnce . "ovhVPSServerIP" "What is the IP v4 of your OVH VPS server? " -}}
{{ $nameDict := splitn " " 2 $fullname }}


{{- $chassisType := (output "hostnamectl" "--json=short" | mustFromJson).Chassis | default "desktop" -}}

{{/* Detect NVIDIA GPU generation for driver selection.
     sysfs, not lspci: lspci reads live PCI config space, which resumes a
     runtime-suspended discrete GPU out of D3cold on hybrid laptops. sysfs
     vendor/class/device files are populated once at enumeration and never
     touch the live device, so they're safe to read regardless of power state. */}}
{{- $nvidiaDriverType := "modern" -}}
{{- $nvidiaGpuName := "" -}}

{{- $nvidiaScanScript := `
d=""
for dev in /sys/bus/pci/devices/*/; do
  v=$(cat "${dev}vendor" 2>/dev/null)
  c=$(cat "${dev}class" 2>/dev/null)
  if [ "$v" = "0x10de" ]; then
    case "$c" in 0x03*) d="${dev}"; break ;; esac
  fi
done
[ -z "$d" ] && exit 0
did=$(cat "${d}device" 2>/dev/null | sed 's/^0x//')
pciids=/usr/share/hwdata/pci.ids
[ -f "$pciids" ] || pciids=/usr/share/misc/pci.ids
name=""
if [ -f "$pciids" ]; then
  name=$(awk -v did="$did" '
    $0 ~ "^10de[ \t]" { invend=1; next }
    invend && /^\t[0-9a-f]{4}[ \t]/ {
      id=substr($0,2,4)
      if (id == did) { sub(/^\t[0-9a-f]{4}[ \t]+/, ""); print; exit }
    }
  ' "$pciids")
fi
printf '%s|%s\n' "$did" "$name"
` -}}

{{- $hasIntegratedGpuScript := `
for dev in /sys/bus/pci/devices/*/; do
  v=$(cat "${dev}vendor" 2>/dev/null)
  c=$(cat "${dev}class" 2>/dev/null)
  case "$v" in
    0x8086|0x1002)
      case "$c" in 0x03*) echo yes; exit 0 ;; esac
      ;;
  esac
done
` -}}

{{/* Check for environment variable override first */}}
{{- if env "NVIDIA_DRIVER_OVERRIDE" -}}
{{-   $nvidiaDriverType = env "NVIDIA_DRIVER_OVERRIDE" -}}
{{- else -}}
{{-   $nvidiaScanResult := output "sh" "-c" $nvidiaScanScript | trim -}}
{{-   if $nvidiaScanResult -}}
{{-     $parts := splitList "|" $nvidiaScanResult -}}
{{-     $nvidiaDeviceId := index $parts 0 -}}
{{-     $nvidiaDeviceName := index $parts 1 | lower -}}
{{-     $nvidiaGpuName = printf "10de:%s" $nvidiaDeviceId -}}
{{-     if regexMatch "gtx (9[0-9]{2}|10[0-9]{2})|titan (x|xp|z)\\b|quadro (k|m|p)[0-9]|quadro fx" $nvidiaDeviceName -}}
{{-       $nvidiaDriverType = "legacy" -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

{{- $hasIntegratedGpu := ne (output "sh" "-c" $hasIntegratedGpuScript | trim) "" -}}


encryption: "age"
age:
    command: "rage"
    identity: "~/.keys/dotfiles-key.txt"
    recipient: "age1qn34rhnnzyav6fe7jk74dyhusl3cjmr3p7e00x99slv0g8gunv3sz4k5re"

edit:
    command: "code"
    args: ["--wait"]

data:
    fullname: {{ $fullname | quote }}
    firstname: {{ $nameDict._0 | quote }}
    workEmail: {{ $workEmail | quote }}
    personalEmail: {{ $personalEmail | quote }}
    privateServer: {{ $privateServer | quote }}
    chassisType: {{ $chassisType | quote }}
    currentDesktop: {{ env "XDG_CURRENT_DESKTOP" | quote }}
    ovhKS5ServerIP: {{ $ovhKS5ServerIP }}
    ovhVPSServerIP: {{ $ovhVPSServerIP }}
    nvidiaDriverType: {{ $nvidiaDriverType | quote }}
    nvidiaGpuDetected: {{ $nvidiaGpuName | quote }}
    hasIntegratedGpu: {{ $hasIntegratedGpu }}

diff:
  pager: "delta"
  command: "delta"
  args: ["--paging=never"]

# Guard wrapper, not mergiraf directly: .Source is the raw source-state file,
# so for modify_ / *.tmpl entries it is the generator, not a prior revision of
# the target. Merging those overwrites the generator with rendered data (and the
# old `-o <Source>` argument made that certain).
# The guard refuses generators and delegates plain files to mergiraf.
# Argument order MUST stay Source, Destination, Target — the guard asserts it.
merge:
  command: {{ printf "%q" (joinPath .chezmoi.sourceDir ".scripts" "chezmoi-merge-guard.sh") }}
  args:
  - {{ printf "%q" "{{ .Source }}" }}
  - {{ printf "%q" "{{ .Destination }}" }}
  - {{ printf "%q" "{{ .Target }}" }}

hooks:
    read-source-state:
        pre:
            command: ".local/share/chezmoi/.scripts/install-password-manager-and-encryption.sh"
