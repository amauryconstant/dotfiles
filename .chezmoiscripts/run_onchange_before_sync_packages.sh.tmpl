#!/usr/bin/env bash

# Script: run_onchange_before_sync_packages.sh.tmpl
# Purpose: Sync the declared package set (packages.yaml) via package-manager
# Requirements: Arch Linux, paru, yq, flatpak
# Execution: First install AND whenever the declared set or the tool changes (hash-triggered)
# Timing: BEFORE file application, so the tool runs from the chezmoi SOURCE tree, not ~/.local
# Design: the template renders the declared set (enabled modules + NVIDIA driver choice);
#         package-manager installs it and removes what the previous sync declared but this one doesn't.

{{- $pm := printf "%s/private_dot_local/lib/scripts/system/package-manager" .chezmoi.sourceDir }}
# Hash: {{ .packages | toJson | sha256sum }}
# Tool: {{ include (printf "%s/executable_package-manager" $pm) | sha256sum }}
# Tool: {{ include (printf "%s/lib/sync.sh" $pm) | sha256sum }}
# Tool: {{ include (printf "%s/lib/tripwire.sh" $pm) | sha256sum }}

{{ includeTemplate "log_start" "Syncing packages from packages.yaml..." }}

set -euo pipefail

DECLARED=$(mktemp)
trap 'rm -f "$DECLARED"' EXIT

# Enabled modules, flattened. NVIDIA: exactly one driver module, chosen by GPU detection
# ({{ .nvidiaDriverType }}), not by the `enabled` flags in packages.yaml.
cat >"$DECLARED" <<'DECLARED_EOF'
{{- range $name, $module := .packages.modules }}
{{- $on := $module.enabled }}
{{- if eq $name "graphics_drivers_legacy" }}{{ $on = eq $.nvidiaDriverType "legacy" }}{{ end }}
{{- if eq $name "graphics_drivers_modern" }}{{ $on = ne $.nvidiaDriverType "legacy" }}{{ end }}
{{- if $on }}
{{- range $module.packages }}
{{ . }}
{{- end }}
{{- end }}
{{- end }}
DECLARED_EOF

{{ includeTemplate "log_step" "Running package-manager sync..." }}

UI_LIB="{{ .chezmoi.sourceDir }}/private_dot_local/lib/scripts/core/executable_gum-ui.sh" \
    bash "{{ $pm }}/executable_package-manager" sync "$DECLARED"

{{ includeTemplate "log_complete" "Package sync complete" }}
